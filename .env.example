# Optional. Set to a domain pointing at this server to get a real
# Let's Encrypt certificate. Leave unset for a self-signed cert on
# https://<server-ip>:8443 — the panel works either way.
PANEL_DOMAIN=

# Optional. Host or IP embedded in generated tg:// links. Once a proxy's
# container is healthy, the panel prefers telemt's own self-reported link
# (telemt detects the server's external address itself), so this can stay
# unset on most installs. Until a proxy first becomes healthy, though, the
# panel has no address to show and displays a warning instead of a link that
# would not work — set this if you want a working link immediately, or if
# you're behind NAT/a load balancer where telemt's own detection would guess
# wrong.
PANEL_PUBLIC_HOST=

# Optional. Pin a telemt version instead of tracking latest.
TELEMT_IMAGE=ghcr.io/telemt/telemt:latest

# Optional. Absolute HOST path to this repo's ./data directory (Docker
# resolves bind-mount sources on the host, not inside the panel container).
# Defaults to $PWD/data at the time you run `docker compose up`, which only
# works when $PWD is actually this repo's directory — true for the
# documented `cd telemt-panel && docker compose up -d` install, but not
# guaranteed under a systemd unit or some sudo configurations, where an
# empty $PWD would silently collapse the default to "/data" and every proxy
# would start with no config. Set this explicitly if you run compose from
# anything other than an interactive shell in this directory, e.g.:
#   PANEL_HOST_DATA_DIR=/opt/telemt-panel/data
PANEL_HOST_DATA_DIR=
